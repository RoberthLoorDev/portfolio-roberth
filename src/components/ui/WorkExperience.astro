---
import { Image } from 'astro:assets'
import { work, education } from '../../assets/images'
import Tags from '../ui/Tags.astro'
import { arrowUp } from '../../assets/icons/images'

interface Props {
     title: string
     date: string
     isLast?: boolean
     isEducation?: boolean
     tags?: string[]
     link?: string
     titleKey?: string
     dateKey?: string
}

const { isLast, date, title, isEducation, tags = [''], link, titleKey, dateKey } = Astro.props
---

<div class="flex mb-16 relative">
     <Image
          class="w-auto h-6 mb-24 mt-6"
          alt="Work Experience"
          src={isEducation ? education : work}
     />

     <!-- Line -->
     {
          isLast ? (
               ''
          ) : (
               <div class="absolute w-[2px] h-[100%] bg-primary top-16 left-3 rounded-lg" />
          )
     }

     {
          link ? (
               <a href={link} target="_blank" class="box-experience ml-5">
                    <span class="text-base text-textGray" data-i18n={dateKey}>{date}</span>
                    <h4
                         class="title-experience -mt-[2px] underline lg:no-underline"
                         class:list={{ ['hover:underline']: link }}
                         data-i18n={titleKey}
                    >
                         {title}
                         <p
                              class="inline-block rotate-45 ml-3"
                              class:list={{ hidden: !link }}
                         >
                              ↑
                         </p>
                    </h4>
                    <p class="mt-4 text-base font-light">
                         <slot />
                         <div class="flex mt-1 flex-wrap">
                              {tags.map((tag) => (
                                   <Tags title={tag} />
                              ))}
                         </div>
                    </p>
               </a>
          ) : (
               <div class="box-experience ml-5">
                    <span class="text-base text-textGray" data-i18n={dateKey}>{date}</span>
                    <h4 class="title-experience -mt-[2px]" data-i18n={titleKey}>{title}</h4>
                    <p class="mt-4 text-base font-light">
                         <slot />
                         <div class="flex mt-1 flex-wrap">
                              {tags.map((tag) => (
                                   <Tags title={tag} />
                              ))}
                         </div>
                    </p>
               </div>
          )
     }
</div>
