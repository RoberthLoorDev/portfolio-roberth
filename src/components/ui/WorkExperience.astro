---
import Tags from '../ui/Tags.astro'

interface Props {
     title: string
     date: string
     isEducation?: boolean
     /** The role held today: gets the amber "live" marker on the timeline */
     current?: boolean
     tags?: string[]
     link?: string
     titleKey?: string
     dateKey?: string
}

const { date, title, isEducation, current, tags = [], link, titleKey, dateKey } = Astro.props
const visibleTags = tags.filter(Boolean)
const Card = link ? 'a' : 'div'
const cardProps = link ? { href: link, target: '_blank', rel: 'noopener' } : {}
---

<article
     class:list={['tl-item', { 'tl-item--current': current, 'tl-item--edu': isEducation }]}
>
     <span class="tl-node" aria-hidden="true"></span>

     <Card class="tl-card" {...cardProps}>
          <header class="tl-head">
               <p class="tl-date" data-i18n={dateKey}>{date}</p>
               {link && <span class="tl-arrow" aria-hidden="true">↗</span>}
          </header>

          <h4 class="tl-title" data-i18n={titleKey}>{title}</h4>

          <div class="tl-body">
               <slot />
          </div>

          {
               visibleTags.length > 0 && (
                    <ul class="tl-tags">
                         {visibleTags.map((tag) => (
                              <li>
                                   <Tags title={tag} subtle />
                              </li>
                         ))}
                    </ul>
               )
          }
     </Card>
</article>

<style>
     .tl-item {
          position: relative;
     }

     /* node sitting on the timeline track (the track and its gutter come from .timeline) */
     .tl-node {
          position: absolute;
          top: 1.6rem;
          left: calc(var(--tl-line-x) - var(--tl-gutter) - 0.4375rem);
          z-index: 1;
          width: 0.875rem;
          height: 0.875rem;
          border: 2px solid var(--c-blue-soft);
          border-radius: 50%;
          background: var(--c-ink);
          box-shadow: 0 0 0 4px var(--c-ink);
          transition:
               background 0.25s,
               border-color 0.25s;
     }

     .tl-item:hover .tl-node {
          background: var(--c-blue-soft);
     }

     /* today's role: amber like every "live" detail on the site, with a slow ping */
     .tl-item--current .tl-node {
          border-color: var(--c-amber);
          background: var(--c-amber);
          box-shadow:
               0 0 0 4px var(--c-ink),
               0 0 16px rgba(255, 180, 84, 0.55);
     }

     .tl-item--current .tl-node::after {
          content: '';
          position: absolute;
          inset: -2px;
          border: 1px solid var(--c-amber);
          border-radius: 50%;
          animation: tl-ping 2.6s ease-out infinite;
     }

     @keyframes tl-ping {
          from {
               transform: scale(1);
               opacity: 0.7;
          }
          to {
               transform: scale(2.6);
               opacity: 0;
          }
     }

     .tl-card {
          display: block;
          padding: 1.35rem 1.5rem 1.4rem;
          border: 1px solid var(--c-line);
          border-radius: 1.1rem;
          background: linear-gradient(180deg, rgba(14, 23, 46, 0.6), rgba(14, 23, 46, 0.28));
          color: inherit;
          text-decoration: none;
          transition:
               border-color 0.25s,
               transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
               box-shadow 0.25s;
     }

     .tl-card:hover {
          border-color: var(--c-line-strong);
          transform: translateY(-2px);
          box-shadow: 0 22px 44px -30px rgba(0, 124, 255, 0.7);
     }

     .tl-card:focus-visible {
          outline: 2px solid var(--c-cyan);
          outline-offset: 3px;
     }

     .tl-head {
          display: flex;
          align-items: center;
          gap: 0.6rem;
     }

     .tl-date {
          margin: 0;
          font-size: 0.82rem;
          font-weight: 500;
          letter-spacing: 0.01em;
          font-variant-numeric: tabular-nums;
          color: var(--c-muted);
     }

     .tl-item--current .tl-date::before {
          content: '';
          display: inline-block;
          width: 0.4rem;
          height: 0.4rem;
          margin-right: 0.5rem;
          border-radius: 50%;
          background: var(--c-amber);
          vertical-align: middle;
     }

     .tl-arrow {
          margin-left: auto;
          font-size: 1rem;
          line-height: 1;
          color: var(--c-muted);
          transition:
               transform 0.25s,
               color 0.25s;
     }

     .tl-card:hover .tl-arrow {
          color: var(--c-blue-soft);
          transform: translate(2px, -2px);
     }

     .tl-title {
          margin: 0.4rem 0 0.75rem;
          font-size: 1.1rem;
          font-weight: 600;
          line-height: 1.35;
          color: #fff;
     }

     /* descriptions come from the translations; keep them calm and let the <f> highlights speak */
     .tl-body :global(p),
     .tl-body :global(span) {
          margin: 0;
          font-size: 0.95rem;
          font-weight: 400;
          line-height: 1.72;
          color: var(--c-muted);
     }

     .tl-tags {
          display: flex;
          flex-wrap: wrap;
          gap: 0.4rem;
          margin: 1.05rem 0 0;
          padding: 0;
          list-style: none;
     }

     .tl-item:hover :global(.tag-subtle) {
          border-color: var(--c-line-strong);
     }

     /* phones: give the text more room */
     @media (max-width: 639px) {
          .tl-card {
               padding: 1.1rem 1.1rem 1.2rem;
          }
     }

     @media (prefers-reduced-motion: reduce) {
          .tl-item--current .tl-node::after {
               animation: none;
          }

          .tl-card,
          .tl-card:hover {
               transition: none;
               transform: none;
          }
     }
</style>
