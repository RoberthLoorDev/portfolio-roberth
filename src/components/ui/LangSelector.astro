---
/**
 * Language selector toggle (EN / ES)
 * Renders two buttons side by side. The active language gets highlighted.
 */
---

<div class="lang" role="group" aria-label="Language">
     <button
          data-lang-btn="en"
          class="lang-btn"
          aria-label="Switch to English"
     >
          EN
     </button>
     <button
          data-lang-btn="es"
          class="lang-btn"
          aria-label="Cambiar a Español"
     >
          ES
     </button>
</div>

<style>
     /* segmented control in the mono face used for data across the site */
     .lang {
          display: inline-flex;
          align-items: center;
          gap: 2px;
          margin-left: 1.5rem;
          padding: 2px;
          border: 1px solid var(--c-line);
          border-radius: 0.65rem;
     }

     .lang-btn {
          padding: 0.28rem 0.6rem;
          border: 0;
          border-radius: 0.45rem;
          background: transparent;
          font-size: 0.78rem;
          font-weight: 600;
          letter-spacing: 0.03em;
          color: var(--c-muted);
          cursor: pointer;
          transition:
               color 0.2s,
               background 0.2s;
     }

     .lang-btn:hover {
          color: var(--c-text);
     }

     .lang-btn.lang-active {
          background: rgba(0, 124, 255, 0.2);
          color: var(--c-text);
     }

     .lang-btn:focus-visible {
          outline: 2px solid var(--c-cyan);
          outline-offset: 1px;
     }
</style>
