---
import { Image } from 'astro:assets'
import Tags from '../../components/ui/Tags.astro'

interface Props {
     title: string
     tags: string[]
     description: string
     image: ImageMetadata
     icon: ImageMetadata
     link: string
     descKey?: string
     /** Full-width card with the screenshot beside the text (used for the flagship project) */
     featured?: boolean
}

const { title, description, image, tags, icon, link, descKey, featured = false } = Astro.props
---

<a
     href={link}
     target="_blank"
     rel="noopener"
     data-reveal
     class:list={['project', { 'project--featured': featured }]}
>
     <div class="project__body">
          <header class="project__head">
               <Image class="project__icon" src={icon} alt="" />
               <h4 class="project__title">{title}</h4>
               <span class="project__arrow" aria-hidden="true">↗</span>
          </header>

          <p class="project__desc" data-i18n={descKey}>
               {description}
          </p>

          <ul class="project__tags">
               {
                    tags.map((tag) => (
                         <li>
                              <Tags title={tag} subtle />
                         </li>
                    ))
               }
          </ul>
     </div>

     <div class="project__shot">
          <Image src={image} alt={`${title} screenshot`} />
     </div>
</a>

<style>
     .project {
          display: flex;
          flex-direction: column;
          gap: 1.4rem;
          padding: 1.5rem;
          overflow: hidden;
          border: 1px solid var(--c-line);
          border-radius: 1.25rem;
          background: linear-gradient(180deg, rgba(14, 23, 46, 0.6), rgba(14, 23, 46, 0.28));
          color: inherit;
          text-decoration: none;
          transition:
               opacity 0.7s ease var(--reveal-delay, 0s),
               transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--reveal-delay, 0s),
               border-color 0.25s,
               box-shadow 0.25s,
               translate 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
     }

     /*
      * Scroll reveal. The cards are only hidden once JavaScript has flagged the page
      * (html.js, set inline before the grid), so with no JS they are simply visible.
      * The observer in Projects.astro adds .is-in as soon as a card peeks into view.
      */
     :global(html.js) .project[data-reveal]:not(.is-in) {
          opacity: 0;
          transform: translateY(32px);
     }

     /* `translate` is its own property, so the hover lift composes with the reveal above */
     .project:hover {
          border-color: var(--c-line-strong);
          box-shadow: 0 30px 60px -38px rgba(0, 124, 255, 0.75);
          translate: 0 -3px;
     }

     .project:focus-visible {
          outline: 2px solid var(--c-cyan);
          outline-offset: 3px;
     }

     .project__body {
          display: flex;
          flex-direction: column;
          gap: 1rem;
     }

     .project__head {
          display: flex;
          align-items: center;
          gap: 0.8rem;
     }

     .project__icon {
          flex: none;
          width: 2.5rem;
          height: 2.5rem;
          padding: 0.45rem;
          object-fit: contain;
          border: 1px solid var(--c-line);
          border-radius: 0.75rem;
          background: rgba(0, 124, 255, 0.1);
     }

     .project__title {
          margin: 0;
          font-size: 1.15rem;
          font-weight: 600;
          line-height: 1.3;
          color: #fff;
     }

     .project__arrow {
          margin-left: auto;
          font-size: 1.05rem;
          line-height: 1;
          color: var(--c-muted);
          transition:
               transform 0.25s,
               color 0.25s;
     }

     .project:hover .project__arrow {
          color: var(--c-blue-soft);
          transform: translate(2px, -2px);
     }

     .project__desc {
          margin: 0;
          font-size: 0.93rem;
          font-weight: 400;
          line-height: 1.7;
          color: var(--c-muted);
     }

     .project__tags {
          display: flex;
          flex-wrap: wrap;
          gap: 0.4rem;
          margin: 0;
          padding: 0;
          list-style: none;
     }

     .project:hover :global(.tag-subtle) {
          border-color: var(--c-line-strong);
     }

     /* every screenshot gets the same frame, whatever its original proportions */
     .project__shot {
          margin-top: auto;
          aspect-ratio: 16 / 10;
          overflow: hidden;
          border: 1px solid var(--c-line);
          border-radius: 0.9rem;
          background: var(--c-ink);
     }

     .project__shot :global(img) {
          display: block;
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: 12% top;
          transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
     }

     .project:hover .project__shot :global(img) {
          transform: scale(1.035);
     }

     /* flagship: text on the left, screenshot on the right */
     @media (min-width: 1024px) {
          .project--featured {
               display: grid;
               grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
               align-items: center;
               gap: 2.5rem;
               padding: 2rem;
          }

          .project--featured .project__body {
               gap: 1.25rem;
          }

          .project--featured .project__title {
               font-size: 1.5rem;
          }

          .project--featured .project__desc {
               font-size: 1rem;
          }

          .project--featured .project__shot {
               margin-top: 0;
          }
     }

     @media (prefers-reduced-motion: reduce) {
          :global(html.js) .project[data-reveal]:not(.is-in) {
               opacity: 1;
               transform: none;
          }

          .project,
          .project:hover,
          .project__shot :global(img) {
               transition: none;
               translate: none;
               transform: none;
          }
     }
</style>
