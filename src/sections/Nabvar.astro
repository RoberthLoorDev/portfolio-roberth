---
import LangSelector from '../components/ui/LangSelector.astro'
---

<nav class="topbar hidden lg:block" data-scrolled="false" aria-label="Main">
     <div class="topbar__inner">
          <a href="/" class="brand" aria-label="Roberth Loor">
               <b class="brand__mark" aria-hidden="true">RL</b>
               <span class="brand__name">Roberth Loor</span>
          </a>

          <div class="topbar__right">
               <a id="id_section_2" href="/#experience_section" class="nav-link"
                    ><span data-i18n="nav.experience">Experience</span></a
               >
               <a id="id_section_3" href="/#projects_section" class="nav-link"
                    ><span data-i18n="nav.projects">Projects</span></a
               >
               <a id="id_section_1" href="/#skill_section" class="nav-link"
                    ><span data-i18n="nav.skills">Skills</span></a
               >
               <a id="id_section_4" href="/#about_me_section" class="nav-link"
                    ><span data-i18n="nav.about">About me</span></a
               >
               <a id="id_section_5" href="/#contact_me_section" class="nav-link nav-cta"
                    ><span data-i18n="nav.contact">Contact me</span></a
               >
               <LangSelector />
          </div>
     </div>
</nav>

<!-- Lateral navbar -->
<nav
     id="id_lateral_navbar"
     class="lateral_navbar fixed h-full right-0 w-52 flex flex-col z-20 justify-center bg-background shadow-lateral-navbar lg:hidden"
>
     <a
          id="id_section_2"
          href="/#experience_section"
          class="text-white text-base font-semibold drop-shadow-lg ml-5 mt-8 flex"
     >
          <svg
               xmlns="http://www.w3.org/2000/svg"
               width="24"
               height="24"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round"
               class="mr-2"
               ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                    d="M3 19l18 0"></path><path
                    d="M5 6m0 1a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v8a1 1 0 0 1 -1 1h-12a1 1 0 0 1 -1 -1z"
               ></path></svg
          >
          <span data-i18n="nav.experience">Experience</span></a
     >
     <a
          id="id_section_3"
          href="/#projects_section"
          class="text-white text-base font-semibold drop-shadow-lg ml-5 mt-8 flex"
     >
          <svg
               xmlns="http://www.w3.org/2000/svg"
               width="24"
               height="24"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round"
               class="mr-2"
               ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                    d="M7 8l-4 4l4 4"></path><path d="M17 8l4 4l-4 4"></path><path
                    d="M14 4l-4 16"></path></svg
          >
          <span data-i18n="nav.projects">Projects</span></a
     >
     <a
          id="id_section_1"
          href="/#skill_section"
          class="text-white text-base font-semibold drop-shadow-lg ml-5 mt-8 flex"
     >
          <svg
               width="24"
               height="24"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round"
               class="mr-2"
               ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                    d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"
               ></path><path d="M13.5 6.5l4 4"></path></svg
          >
          <span data-i18n="nav.skills">Skills</span></a
     >
     <a
          id="id_section_4"
          href="/#about_me_section"
          class="text-white text-base font-semibold drop-shadow-lg ml-5 mt-8 flex"
     >
          <svg
               xmlns="http://www.w3.org/2000/svg"
               width="24"
               height="24"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round"
               class="mr-2"
               ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                    d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"></path><path
                    d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path></svg
          >

          <span data-i18n="nav.about">About me</span></a
     >

     <a
          id="id_section_4"
          href="/#contact_me_section"
          class="text-white text-base font-semibold drop-shadow-lg ml-5 mt-8 flex"
     >
          <svg
               xmlns="http://www.w3.org/2000/svg"
               width="24"
               height="24"
               viewBox="0 0 24 24"
               fill="none"
               stroke="#ffffff"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round"
               class="icon icon-tabler icons-tabler-outline icon-tabler-inbox mr-2"
               ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                    d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"
               ></path><path d="M4 13h3l3 3h4l3 -3h3"></path></svg
          >
          <span data-i18n="nav.contact">Contact me</span></a
     >
     <LangSelector />
</nav>

<!-- button lateral navbar -->
<button
     id="id_toggleButton_navbar"
     class="fixed bottom-5 right-5 bg-primary w-12 h-12 rounded-full z-50 flex justify-center items-center active:opacity-50 transition duration-100 lg:hidden"
>
     <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#ffffff"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 6l16 0"
          ></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path></svg
     >
</button>

<script>
     //navegar entre secciones

     const navLinks = document.querySelectorAll('nav a')
     const handleScroll = () => {
          const scrollPosition = window.pageYOffset || document.documentElement.scrollTop
          const sectionsArray = document.querySelectorAll('section')
          sectionsArray.forEach((section) => {
               const sectionTop = section.offsetTop - 200
               const sectionBottom = sectionTop + section.offsetHeight

               //verificar si la posicion actual esta dentro de la seccion
               if (scrollPosition > sectionTop && scrollPosition < sectionBottom) {
                    const sectionId = section.getAttribute('id')

                    navLinks.forEach((link) => {
                         link.classList.remove('active')

                         //agregar el color azul
                         if (link.getAttribute('href') === `/#${sectionId}`) {
                              link.classList.add('active')
                         }
                    })
               }
          })
     }
     window.addEventListener('scroll', handleScroll)

     // the top bar is transparent over the hero and gets a frosted background once you scroll
     const topbar = document.querySelector('.topbar')
     const updateScrolled = () =>
          topbar?.setAttribute('data-scrolled', String(window.scrollY > 8))
     window.addEventListener('scroll', updateScrolled, { passive: true })
     updateScrolled()

     //mostrar navbar lateral
     document.addEventListener('DOMContentLoaded', () => {
          const navbar = document.getElementById('id_lateral_navbar')
          const toggleButton = document.getElementById('id_toggleButton_navbar')

          toggleButton?.addEventListener('click', () => {
               if (navbar?.classList.contains('navbar_active')) {
                    navbar?.classList.remove('navbar_active')
                    return
               }
               navbar?.classList.add('navbar_active')
          })
     })
</script>

<style>
     /* ---------- top bar (desktop) ---------- */

     .topbar {
          position: fixed;
          inset: 0 0 auto 0;
          z-index: 20;
          height: 4rem;
          border-bottom: 1px solid transparent;
          transition:
               background 0.3s,
               border-color 0.3s;
     }

     .topbar[data-scrolled='true'] {
          background: rgba(9, 12, 26, 0.72);
          border-bottom-color: var(--c-line);
          -webkit-backdrop-filter: blur(14px) saturate(1.2);
          backdrop-filter: blur(14px) saturate(1.2);
     }

     /* same horizontal rhythm as the hero (max 80rem, 5rem side margins) */
     .topbar__inner {
          display: flex;
          align-items: center;
          justify-content: space-between;
          height: 100%;
          max-width: 80rem;
          margin: 0 auto;
          padding: 0 5rem;
     }

     .brand {
          display: inline-flex;
          align-items: center;
          gap: 0.7rem;
          text-decoration: none;
     }

     .brand__mark {
          display: grid;
          place-items: center;
          width: 2rem;
          height: 2rem;
          border: 1px solid var(--c-line-strong);
          border-radius: 0.6rem;
          background: rgba(0, 124, 255, 0.14);
          font-size: 0.72rem;
          font-weight: 700;
          letter-spacing: 0.02em;
          color: var(--c-blue-soft);
          transition:
               background 0.2s,
               border-color 0.2s;
     }

     .brand__name {
          font-size: 0.95rem;
          font-weight: 600;
          color: var(--c-text);
     }

     .brand:hover .brand__mark {
          background: rgba(0, 124, 255, 0.26);
          border-color: var(--c-blue-soft);
     }

     .topbar__right {
          display: flex;
          align-items: center;
          gap: 1.75rem;
     }

     .nav-link {
          position: relative;
          padding: 0.5rem 0;
          font-size: 0.92rem;
          font-weight: 500;
          color: var(--c-muted);
          text-decoration: none;
          transition: color 0.2s;
     }

     /* the global span{color:white} rule would otherwise ignore the link color */
     .nav-link span {
          color: inherit;
     }

     .nav-link::after {
          content: '';
          position: absolute;
          left: 0;
          right: 0;
          bottom: 0.05rem;
          height: 2px;
          border-radius: 2px;
          background: var(--c-blue-soft);
          transform: scaleX(0);
          transform-origin: left;
          transition: transform 0.3s ease;
     }

     .nav-link:hover,
     .nav-link.active {
          color: var(--c-text);
     }

     /* hover draws the full underline (softer); the active section keeps it solid */
     .nav-link:hover::after {
          transform: scaleX(1);
          opacity: 0.55;
     }

     .nav-link.active::after {
          transform: scaleX(1);
          opacity: 1;
     }

     .nav-link:focus-visible,
     .brand:focus-visible {
          outline: 2px solid var(--c-cyan);
          outline-offset: 4px;
          border-radius: 0.4rem;
     }

     /* "Contact me" is the only action in the bar */
     .nav-cta {
          padding: 0.5rem 1rem;
          border: 1px solid var(--c-line-strong);
          border-radius: 0.7rem;
          color: var(--c-text);
          transition:
               background 0.2s,
               border-color 0.2s;
     }

     .nav-cta::after {
          display: none;
     }

     .nav-cta:hover,
     .nav-cta.active {
          background: rgba(103, 171, 255, 0.12);
          border-color: var(--c-blue-soft);
     }

     /* ---------- lateral navbar (mobile) ---------- */

     .shadow-lateral-navbar {
          box-shadow: -1rem 0rem 10rem black;
     }

     .lateral_navbar {
          transform: translateX(150%);
          transition: 250ms;
          background: var(--c-panel);
          border-left: 1px solid var(--c-line);
     }

     .lateral_navbar a {
          color: var(--c-muted);
          transition: color 0.2s;
     }

     .lateral_navbar a span {
          color: inherit;
     }

     .lateral_navbar a:hover,
     .lateral_navbar a.active {
          color: var(--c-text);
     }

     .navbar_active {
          transform: translateX(0);
     }
</style>
