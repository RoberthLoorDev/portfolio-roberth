---
import { Image } from 'astro:assets'
import { github, linkedin, me2 } from '../assets/images'

const socials = [
     {
          name: 'Linkedin',
          href: 'https://www.linkedin.com/in/roberth-loor-837744227/?locale=en_US',
          icon: linkedin,
     },
     { name: 'Github', href: 'https://github.com/RoberthLoorDev', icon: github },
]
---

<section class="relative flex mt-10 lg:mt-28 mx-4 lg:mx-20" id="header_section">
     <div>
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm font-medium mb-3">
               <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
               </span>
               Available for new projects & opportunities
          </div>
          <!-- Mobile Profile Image with Ring -->
          <div class="flex justify-center items-center lg:hidden my-8 relative w-[75vw] h-[75vw] max-w-[380px] max-h-[380px] mx-auto">
               <!-- Mobile Ring Background Wrapper -->
               <div class="absolute inset-0 flex items-center justify-center ring-gradient-opacity">
                    <div class="w-[80%] h-[80%] rounded-full border-[18px] sm:border-[24px] border-[#007cff] shadow-[0_0_25px_#007cff]"></div>
               </div>
               <!-- Mobile Image -->
               <Image
                    src={me2}
                    alt="Roberth Loor"
                    class="w-full h-full object-contain relative z-10 image-fade-bottom"
               />
          </div>
          <span class="text-lg text-primary font-semibold block">Welcome to my portfolio</span>
          <h2
               class="title-presentation font-bold mt-4 text-6xl lg:text-7xl lg:leading-[5.5rem]"
          >
               Hello, my <br /> name's<span class="text-primary"> Roberth</span>.
          </h2>
          <h1
               class="description-presentation text-textGray font-normal text-start mt-5 max-w-lg text-lg leading-relaxed"
          >
               <strong class="text-white font-bold">IT Engineer</strong> focused on <strong class="text-white font-bold">software development</strong> & <strong class="text-white font-bold">technology solutions</strong>, crafting high-performance digital systems and scalable architectures.
          </h1>

          <!-- button section -->
          <div class="flex flex-col">
               <div class="flex gap-6 flex-col lg:flex-row my-12">
                    <a href="mailto:dayvidlife@gmail.com" target="_blank">
                         <button
                              class="text-white bg-[#007cff] h-14 w-36 rounded-xl text-base font-semibold flex items-center justify-center gap-4 border-2 border-[#007cff] duration-150 hover:bg-[#0066d6] hover:border-[#0066d6] active:bg-[#0055b3]"
                         >
                              <svg
                                   xmlns="http://www.w3.org/2000/svg"
                                   width="24"
                                   height="24"
                                   viewBox="0 0 24 24"
                                   fill="none"
                                   stroke="#ffffff"
                                   stroke-width="2"
                                   stroke-linecap="round"
                                   stroke-linejoin="round"
                                   class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
                                   ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                                   ></path><path
                                        d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"
                                   ></path><path d="M3 7l9 6l9 -6"></path></svg
                              >
                              Mail me</button
                         >
                    </a>

                    <a
                         href="https://drive.google.com/file/d/17afGF7g8qTCTxSGsyQ_JI8iwgXGTYfbd/view?usp=sharing"
                         target="_blank"
                    >
                         <button
                              class="text-white h-14 w-48 rounded-xl text-base font-semibold flex items-center justify-center gap-4 border-2 border-[#007cff]"
                         >
                              <svg
                                   xmlns="http://www.w3.org/2000/svg"
                                   width="24"
                                   height="24"
                                   viewBox="0 0 24 24"
                                   fill="none"
                                   stroke="#ffffff"
                                   stroke-width="2"
                                   stroke-linecap="round"
                                   stroke-linejoin="round"
                                   class="icon icon-tabler icons-tabler-outline icon-tabler-download"
                                   ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                                   ></path><path
                                        d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"
                                   ></path><path d="M7 11l5 5l5 -5"></path><path
                                        d="M12 4l0 12"></path></svg
                              >
                              Download CV</button
                         >
                    </a>
               </div>

               <div class="flex items-center h-10">
                    <!-- <span class="font-bold text-lg"> Contact me: </span> -->

                    <!-- social media -->
                    {
                         socials.map(({ name, icon, href }) => (
                              <a
                                   class="p-5 flex justify-center items-center relative network line"
                                   href={href}
                                   target="_blank"
                              >
                                   <Image
                                        class="w-auto h-[19px]"
                                        alt="Linkedin"
                                        src={icon}
                                   />
                                   <span class="font-light text-lg ml-2">{name}</span>
                              </a>
                         ))
                    }
               </div>
          </div>

          <!-- Desktop Profile Image with Ring -->
          <div class="hidden lg:block absolute top-8 right-0 -z-10 w-[450px] h-[450px] xl:w-[650px] xl:h-[650px]">
               <!-- Desktop Ring Background Wrapper -->
               <div class="absolute inset-x-0 -top-5 inset-y-0 m-auto w-[460px] h-[460px] xl:w-[500px] xl:h-[500px] flex items-center justify-center ring-gradient-opacity">
                    <div class="w-[380px] h-[380px] xl:w-[420px] xl:h-[420px] rounded-full border-[68px] border-[#007cff] shadow-[0_0_40px_#007cff]"></div>
               </div>
               <Image
                    src={me2}
                    alt="Roberth Loor"
                    class="w-full h-full object-contain relative z-10 image-fade-bottom"
               />
          </div>
     </div>
</section>

<style>
     /* animations for header */
     .title-presentation {
          animation: title-animation 1s forwards;
     }

     .description-presentation {
          animation: description-animation 1s forwards;
     }

     @keyframes description-animation {
          0% {
               opacity: 0;
               transform: translateY(-50px);
          }

          30% {
               opacity: 0;
          }
          100% {
               opacity: 1;
               transform: translateY(0px);
          }
     }

     @keyframes title-animation {
          0% {
               opacity: 0;
               transform: translateY(100px);
          }
          100% {
               opacity: 1;
               transform: translateY(0px);
          }
     }

     .image-fade-bottom {
          mask-image: linear-gradient(to bottom, black 10%, transparent 100%);
          -webkit-mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
     }

     .ring-gradient-opacity {
          mask-image: linear-gradient(to right, rgba(0,0,0,0.15) 0%, rgba(0,0,0,1) 100%);
          -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0.15) 0%, rgba(0,0,0,1) 100%);
     }
</style>

<style>
     .network {
          position: relative; /* Asegura que el pseudo-elemento ::after esté posicionado respecto al .network */
     }

     .network::after {
          content: ''; /* Contenido generado */
          position: absolute; /* Posición absoluta respecto al div padre */
          bottom: 7px; /* Alineado con el borde inferior del div */
          width: 100%; /* Ancho completo del div */
          height: 4px; /* Altura de la barra inferior */
          background-color: #007cff; /* Color de la barra inferior */
          border-radius: 100px;
          transform: scaleX(
               0
          ); /* Escala inicial cero para que comience desde el centro */
          transform-origin: center; /* Origen de la transformación en el centro */
          transition: transform 0.3s ease; /* Efecto de transición suave solo en la transformación */
     }

     .network:hover::after {
          transform: scaleX(1); /* Escala completa al hacer hover */
     }
</style>
