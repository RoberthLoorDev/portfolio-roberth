---
import ChatMessageForm from '../components/ui/ChatMessageForm'
import knowledge from '../data/embeddings.json'

// Only the count reaches the browser, never the embeddings themselves
const knowledgeCount = knowledge.chunks.length
---

<section class="mt-5 flex flex-col gap-12 lg:flex-row mx-4 lg:mx-20" id="chatbot_section">
     <ChatMessageForm client:load knowledgeCount={knowledgeCount} />
</section>
