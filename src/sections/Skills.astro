---
import { Image } from 'astro:assets'
import { arraySkills } from './../assets/skills/skillsImages'

const colorMap: Record<string, string> = {
     // Frontend
     react: '#61DAFB',
     vue: '#4FC08D',
     angular: '#DD0031',
     astro: '#FF5D01',
     tailwind: '#39BCF9',
     javascript: '#F7DF1E',
     typescript: '#3178C6',
     html: '#E34F26',
     css: '#1572B6',
     'next.js': '#ffffff',
     nextjs: '#ffffff',
     shadcn: '#ffffff',

     // backend
     'node.js': '#84BA64',
     nodejs: '#84BA64',
     nestjs: '#E0234E',
     postgresql: '#326790',
     mongodb: '#47A248',
     mysql: '#4479A1',

     // DevOps y otros
     docker: '#2496ED',
     git: '#F05032',
     github: '#ffffff',
     ubuntu: '#E95420',
}

const getColor = (name: string) => {
     const key = name.toLowerCase().trim()

     if (colorMap[key]) return colorMap[key]

     const keyNoDot = key.replace('.', '')
     if (colorMap[keyNoDot]) return colorMap[keyNoDot]

     return '#64748b'
}

// Skills grouped by what they are, so the grid reads as a map instead of a flat list.
// Names that are not listed fall into the last group, so nothing is ever dropped.
const groupDefinitions = [
     {
          label: 'Frontend',
          names: ['react', 'nextjs', 'vue', 'astro', 'tailwind', 'javascript', 'typescript', 'html', 'css', 'shadcn'],
     },
     { label: 'Backend', names: ['nodejs', 'nestjs', 'postgresql', 'mongodb', 'mysql'] },
     { label: 'DevOps', names: ['docker', 'ubuntu'] },
]

const listed = new Set(groupDefinitions.flatMap((group) => group.names))
const groups = groupDefinitions.map((group, index) => ({
     label: group.label,
     skills: arraySkills.filter(
          (skill) =>
               group.names.includes(skill.name) ||
               (index === groupDefinitions.length - 1 && !listed.has(skill.name)),
     ),
}))
---

<section class="skills mt-28 mx-4 lg:mx-20" id="skill_section">
     <h3 class="skills__title" data-i18n="skills.title">Skills</h3>

     <div class="skills__groups">
          {
               groups.map((group) => (
                    <div class="skills-group">
                         <div class="skills-group__head">
                              <h4 class="skills-group__label">{group.label}</h4>
                              <span class="skills-group__count">{group.skills.length}</span>
                              <i class="skills-group__rule" aria-hidden="true" />
                         </div>

                         <div class="skills-grid">
                              {group.skills.map((imageSkill, index) => {
                                   const techColor = getColor(imageSkill.name)

                                   return (
                                        <div
                                             class="skill-card group"
                                             style={`
                --tech-color: ${techColor};
                --tech-color-dim: ${techColor}33;
                transition-delay: ${index * 50}ms;
            `}
                                        >
                                             <div class="glow-bg" />

                                             <Image
                                                  src={imageSkill.icon}
                                                  class="skill-icon w-auto h-[2.75rem] lg:h-[3.25rem] object-contain transition-transform duration-300 group-hover:scale-110 z-10 relative grayscale opacity-50 transition-all"
                                                  alt={`Logo de ${imageSkill.name}`}
                                             />

                                             <p class="skill-name">{imageSkill.name}</p>
                                        </div>
                                   )
                              })}
                         </div>
                    </div>
               ))
          }
     </div>
</section>

<style>
     .skills__title {
          margin: 0 0 2rem;
     }

     .skills__groups {
          display: grid;
          gap: 2.25rem;
     }

     /* ---------- group header ---------- */

     .skills-group__head {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          margin-bottom: 1rem;
     }

     .skills-group__label {
          margin: 0;
          font-size: 0.82rem;
          font-weight: 600;
          letter-spacing: 0.09em;
          text-transform: uppercase;
          color: var(--c-muted);
     }

     .skills-group__count {
          padding: 0.05rem 0.5rem;
          border: 1px solid var(--c-line);
          border-radius: 999px;
          font-size: 0.7rem;
          font-weight: 600;
          color: var(--c-blue-soft);
     }

     .skills-group__rule {
          flex: 1;
          height: 1px;
          background: linear-gradient(90deg, var(--c-line), transparent);
     }

     /* ---------- tiles ---------- */

     .skills-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(124px, 1fr));
          gap: 1rem;
          perspective: 1000px;
     }

     .skill-card {
          position: relative;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          padding: 1.6rem 0.75rem 1.35rem;
          overflow: hidden;
          cursor: pointer;
          border: 1px solid var(--c-line);
          border-radius: 1.1rem;
          background: linear-gradient(180deg, rgba(14, 23, 46, 0.7), rgba(14, 23, 46, 0.35));

          opacity: 0;
          transform: translateY(30px) scale(0.9);
          transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
     }

     .skill-card.reveal {
          opacity: 1;
          transform: translateY(0) scale(1);
     }

     .skill-name {
          position: relative;
          z-index: 10;
          width: 100%;
          margin: 0.8rem 0 0;
          text-align: center;
          text-transform: capitalize;
          font-size: 0.82rem;
          font-weight: 500;
          color: var(--c-muted);
          transition: color 0.3s;
     }

     /* --- hover: each tile lights up with its own brand color --- */
     .skill-card:hover {
          transform: translateY(-5px) scale(1.02);
          border-color: var(--tech-color);
          box-shadow: 0 10px 30px -10px var(--tech-color-dim);
          transition-delay: 0.2s !important;
     }

     .skill-card:hover .skill-name {
          color: #fff;
     }

     /* Drop shadow to the specific color SVG/PNG */
     .skill-card:hover :global(img) {
          filter: drop-shadow(0 0 8px var(--tech-color));
     }

     .glow-bg {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: radial-gradient(circle at center, var(--tech-color) 0%, transparent 70%);
          opacity: 0;
          transition: opacity 0.4s ease;
          z-index: 0;
     }

     .skill-card:hover .glow-bg {
          opacity: 0.15;
     }

     @media (prefers-reduced-motion: reduce) {
          .skill-card {
               opacity: 1;
               transform: none;
               transition: border-color 0.2s;
          }
     }
</style>

<script>
     const initPageScripts = () => {
          runObserver()
          addHoverEffect()
     }

     // animation on scroll using Intersection Observer
     document.addEventListener('astro:page-load', initPageScripts)
     document.addEventListener('DOMContentLoaded', initPageScripts)

     function runObserver() {
          const observer = new IntersectionObserver(
               (entries) => {
                    entries.forEach((entry) => {
                         if (entry.isIntersecting) {
                              entry.target.classList.add('reveal')
                              observer.unobserve(entry.target) // Stop observing to save resources
                         }
                    })
               },
               { threshold: 0.1 }
          )

          const cards = document.querySelectorAll('.skill-card')
          cards.forEach((card) => observer.observe(card))
     }

     function addHoverEffect() {
          const cards = document.querySelectorAll('.skill-card')
          cards.forEach((card) => {
               card.addEventListener(
                    'mouseenter',
                    () => {
                         const img = card.querySelector('img')
                         if (img) {
                              img.classList.remove('grayscale')
                              img.classList.remove('opacity-50')
                         }
                    },
                    { once: true }
               )
          })
     }
</script>
